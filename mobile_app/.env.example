# Android: Use 10.0.2.2 for localhost when running in emulator
API_BASE_URL=http://10.0.2.2:3000/api/v1
# iOS: Use localhost
# API_BASE_URL=http://localhost:3000/api/v1

# Firebase config - generate with: flutterfire configure
# See docs/Firebase-Setup.md
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Android release signing (for local release builds / CI secrets)
ANDROID_STORE_FILE=app-release.keystore
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=your-key-alias
ANDROID_KEY_PASSWORD=your-key-password
